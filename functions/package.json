    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@google-cloud/storage": "^8.4.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0"
  },
  "private": true
}
