{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "eslint .",
    "test:rules": "node --test test/firestore.rules.test.js",
    "migrate:public-profiles": "node migrate-public-profiles.js",
